{
  "name": "mineagent",
  "version": "1.1.0",
  "description": "Autonomous Minecraft AI companion (Mineflayer + local LLM via LM Studio)",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "node src/index.js",
    "test": "node scripts/check.js",
    "test-llm": "node scripts/test-llm.js",
    "test-e2e": "node scripts/e2e.js",
    "player": "node scripts/player.js",
    "gui": "electron .",
    "dist:win": "electron-builder --win --x64",
    "dist:linux": "electron-builder --linux AppImage --x64",
    "dist:dir": "electron-builder --dir"
  },
  "keywords": [
    "minecraft",
    "mineflayer",
    "llm",
    "lm-studio",
    "ai-agent",
    "voyager"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@lancedb/lancedb": "^0.40.0",
    "apache-arrow": "18.1.0",
    "mineflayer": "^4.39.0",
    "mineflayer-auto-eat": "^5.0.3",
    "mineflayer-collectblock": "^1.6.0",
    "mineflayer-pathfinder": "^2.4.5",
    "mineflayer-pvp": "^1.3.2",
    "mineflayer-tool": "^1.2.0",
    "openai": "^7.34.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=18"
  },
  "build": {
    "appId": "ai.mineagent.desktop",
    "productName": "MineAgent",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "files": [
      "electron/**",
      "src/**",
      "config.example.json",
      "package.json",
      "!node_modules/onnxruntime-node/**",
      "!node_modules/onnxruntime-web/**",
      "!node_modules/@huggingface/**",
      "!node_modules/typescript/**",
      "!node_modules/**/minecraft-data/minecraft-data/data/bedrock/[0-9]*/**",
      "!node_modules/**/*.{md,map,ts}",
      "!node_modules/**/{test,tests,__tests__,docs,example,examples}/**",
      "!node_modules/onnxruntime-common/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.png",
      "files": [
        "!node_modules/@lancedb/lancedb-linux-*/**",
        "!node_modules/@lancedb/lancedb-darwin-*/**"
      ]
    },
    "portable": {
      "artifactName": "MineAgent-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "MineAgent-setup.exe",
      "shortcutName": "MineAgent"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "electron/icon.png",
      "files": [
        "!node_modules/@lancedb/lancedb-win32-*/**",
        "!node_modules/@lancedb/lancedb-darwin-*/**"
      ]
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3"
  }
}
